{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"bun-types",
			"$app/types",
			"node"
		],
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts"
	]
}
